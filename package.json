{
  "name": "nekkora-lib",
  "version": "0.1.0",
  "description": "Design system Nekkora — componentes React (tema dark) para automação, observabilidade e produtividade.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "main": "./dist/nekkora-lib.cjs",
  "module": "./dist/nekkora-lib.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/nekkora-lib.js",
      "require": "./dist/nekkora-lib.cjs"
    },
    "./styles.css": "./dist/nekkora-lib.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "build:docs": "vite build --config docs/vite.config.ts",
    "preview:docs": "vite preview --config docs/vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run build:docs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sugar-high": "^2.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
